{
  "name": "verifactu-platform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/verifactu-platform/src",
  "tags": ["scope:frontend", "type:app", "scope:verifactu-platform"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/verifactu-platform",
        "browser": "apps/verifactu-platform/src/main.ts",
        "tsConfig": "apps/verifactu-platform/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/verifactu-platform/public"
          }
        ],
        "styles": ["apps/verifactu-platform/src/styles.css"],
        "polyfills": ["zone.js"]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/verifactu-platform/src/environments/environment.ts",
              "with": "apps/verifactu-platform/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "720kb",
              "maximumError": "1.25mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "12kb",
              "maximumError": "24kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4230
      },
      "configurations": {
        "production": {
          "buildTarget": "verifactu-platform:build:production"
        },
        "development": {
          "buildTarget": "verifactu-platform:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/verifactu-platform/jest.config.cjs",
        "tsConfig": "apps/verifactu-platform/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "verifactu-platform:build",
        "port": 4230,
        "staticFilePath": "dist/apps/verifactu-platform/browser",
        "spa": true
      }
    }
  }
}
