DATABASE_URL=postgresql://postgres:postgres@localhost:55432/generic_crm?schema=public
JWT_SECRET=change_me_in_production_min_32_chars_recommended
JWT_EXPIRES=8h
# Orígenes del front (coma-separados). Por defecto el CRM sirve en 4230; añade 4200 si usas `npm run dev:web:4200`
CORS_ORIGIN=http://localhost:4230,http://localhost:4200
PORT=3120
# Keycloak (login Verifactu CRM desde Babooni Hub)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=josanz-web-app-realm
KEYCLOAK_CLIENT_ID=verifactu-crm-spa
DEFAULT_TENANT_SLUG=demo
# Cola canónica en ERP (josanz_erp) + verifactu-worker. No activar el procesador CRM salvo dev aislado.
VERIFACTU_USE_ERP_WORKER=true
VERIFACTU_CRM_QUEUE_PROCESSOR_ENABLED=false
ERP_API_URL=http://localhost:3000/api
# Si es true, al emitir factura (PATCH .../issue) se encola automáticamente en Verifactu.
VERIFACTU_AUTO_ENQUEUE=false
# Cifrado de certificados PEM guardados por tenant (hex 64 chars o base64 de 32 bytes)
# VERIFACTU_CREDENTIALS_ENCRYPTION_KEY=

# AEAT_MODE=http | stub (por defecto stub para desarrollo)
AEAT_SUBMISSION_MODE=stub

# Redis for BullMQ queues (required for verifactu-worker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Idempotency
VERIFACTU_IDEMPOTENCY_ENABLED=true
# Huella interna previa al envío: none | sha256-canonical-json (por defecto)
# AEAT_SEAL_MODE=sha256-canonical-json
# Modo http: NIF del emisor (obligado) en este despliegue; luego por tenant si aplica
# AEAT_EMISOR_NIF=B00000000
# Sin red pero con cuerpo AEAT mapeado (útil para probar cola/logs)
# AEAT_DRY_RUN=true
# Cuando AEAT_SUBMISSION_MODE=http y AEAT_DRY_RUN=false
# AEAT_VERIFACTU_HTTP_BASE_URL=http://localhost:3999
# Timeout del POST (ms), mínimo 5000; por defecto 120000
# AEAT_HTTP_TIMEOUT_MS=120000
# AEAT_VERIFACTU_HTTP_PATH=/registro-factura
# AEAT_SCHEMA_VERSION=1.0.0
# AEAT_SUBMISSION_ENV=test
# Encadenamiento opcional (último registro aceptado)
# AEAT_ENCADENAMIENTO_HUELLA=
# AEAT_ENCADENAMIENTO_ID_REGISTRO=
# Cabecera opcional (p. ej. Bearer si tu gateway lo exige)
# AEAT_HTTP_HEADER_AUTHORIZATION=
# mTLS opcional hacia HTTPS (PEM)
# AEAT_TLS_CLIENT_CERT_PATH=
# AEAT_TLS_CLIENT_KEY_PATH=
# Solo laboratorio: AEAT_TLS_INSECURE=true desactiva verificación del servidor TLS
# AEAT_TLS_INSECURE=false

# Réplica de facturas desde ERP backend (POST /api/internal/erp/invoices/mirror)
CRM_ERP_SYNC_API_KEY=dev-crm-erp-sync
# Webhooks ERP → CRM (POST /api/internal/erp/verifactu/webhook-event, header X-Verifactu-Signature)
CRM_ERP_WEBHOOK_SECRET=dev-crm-erp-sync
