# Copiar a apps/backend/.env (no commitear .env).
# Con `docker compose up` el Postgres del repo expone 5435→5432 (ver docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/josanz_erp?schema=public"

PORT=3000
JWT_SECRET=dev-only-replace-with-at-least-32-chars
JWT_EXPIRES=24h
CORS_ORIGIN=http://localhost:4200,http://localhost:4210,http://localhost:4230,http://localhost:4300

# Keycloak OIDC (opcional). Tenants con KC: josanz, babooni (ver TENANT_KEYCLOAK_REALM en identity-api).
# Tenants demo (alexis, docs): login local; usuarios en seed ERP, no en Keycloak.
# Infra KC: docker compose up keycloak keycloak-db (BD keycloak-db ≠ postgres ERP).
KEYCLOAK_ENABLED=true
KEYCLOAK_REALM=josanz-web-app-realm
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8081
KEYCLOAK_SSL_REQUIRED=none
KEYCLOAK_RESOURCE=josanz-erp-api
KEYCLOAK_CREDENTIALS_SECRET=josanz-erp-api-secret
KEYCLOAK_TOKEN_LEEWAY=60

# Sesiones BFF (cookies HttpOnly). Redis evita perder sesión al reiniciar el backend.
BFF_SESSION_MAX_AGE_HOURS=24
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:4200
# Alternativa: REDIS_HOST=localhost + REDIS_PORT=6379

# Réplica facturas ERP → app Verifactu (generic_crm). Opcional: si falta, solo se encola en josanz_erp.
VERIFACTU_CRM_API_URL=http://localhost:3120/api
CRM_ERP_SYNC_API_KEY=dev-crm-erp-sync
# Secreto HMAC para webhooks ERP → CRM (por defecto usa CRM_ERP_SYNC_API_KEY en dev)
CRM_ERP_WEBHOOK_SECRET=dev-crm-erp-sync

# Email (SMTP). Sin SMTP_HOST se imprimen los correos en consola del backend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Babooni ERP <noreply@example.com>"
