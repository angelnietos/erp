# Copiar a apps/backend/.env (no commitear .env).
# Con `docker compose up` el Postgres del repo expone 5435→5432 (ver docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/josanz_erp?schema=public"

PORT=3000
JWT_SECRET=dev-only-replace-with-at-least-32-chars
CORS_ORIGIN=http://localhost:4200,http://localhost:4300

# Keycloak OIDC Configuration (optional - for dual auth mode)
KEYCLOAK_ENABLED=true
KEYCLOAK_REALM=josanz-web-app-realm
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8081
KEYCLOAK_SSL_REQUIRED=none
KEYCLOAK_RESOURCE=josanz-erp-api
KEYCLOAK_CREDENTIALS_SECRET=josanz-erp-api-secret
KEYCLOAK_TOKEN_LEEWAY=60
