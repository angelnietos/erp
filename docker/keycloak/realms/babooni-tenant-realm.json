        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "client_roles",
            "client.id": "josanz-web-app-spa",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": {
    "openid": { "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    "profile": { "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    "email": { "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
