# Copiar a deploy/.env (producción) o deploy/.env.staging en el servidor.
# No commitear secretos. GHCR: owner/repo en minúsculas.

COMPOSE_PROFILES=josanz,core

DATABASE_URL=postgresql://postgres:CAMBIAR@postgres:5432/josanz_erp?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=josanz_erp

JWT_SECRET=CAMBIAR_MINIMO_32_CARACTERES
JWT_REFRESH_SECRET=OTRO_SECRETO_LARGO
CORS_ORIGIN=https://erp.tudominio.com,http://localhost:8082

# Imágenes GHCR (tag = rama o sha publicado por CI)
BACKEND_IMAGE=ghcr.io/tu-org/tu-repo/backend:main
FRONTEND_IMAGE=ghcr.io/tu-org/tu-repo/frontend:main
JOSANZ_WEB_APP_IMAGE=ghcr.io/tu-org/tu-repo/josanz-web-app:main
SAAS_PLATFORM_IMAGE=ghcr.io/tu-org/tu-repo/saas-platform:main
DOCUMENT_GENERATOR_IMAGE=ghcr.io/tu-org/tu-repo/document-generator:main
VERIFACTU_API_IMAGE=ghcr.io/tu-org/tu-repo/verifactu-api:main
VERIFACTU_WORKER_IMAGE=ghcr.io/tu-org/tu-repo/verifactu-worker:main

# Puertos HTTP publicados en el VPS (ajustar si hay reverse proxy)
FRONTEND_HTTP_PORT=8081
JOSANZ_WEB_APP_HTTP_PORT=8082
SAAS_PLATFORM_HTTP_PORT=8083
DOCUMENT_GENERATOR_HTTP_PORT=8084

# Legacy (solo si usas perfil legacy-front en lugar de josanz)
# HTTP_PORT=80
