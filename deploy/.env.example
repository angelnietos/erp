# Copiar a deploy/.env (producción) o deploy/.env.staging en el servidor.
# No commitear secretos. GHCR: owner/repo en minúsculas.

COMPOSE_PROFILES=josanz,core

DATABASE_URL=postgresql://postgres:CAMBIAR@postgres:5432/josanz_erp?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=josanz_erp

JWT_SECRET=CAMBIAR_MINIMO_32_CARACTERES
JWT_REFRESH_SECRET=OTRO_SECRETO_LARGO
CORS_ORIGIN=https://erp.tudominio.com,http://localhost:8082

# Imágenes GHCR — repo: github.com/angelnietos/erp
# Tags: main (producción), dev (staging), o SHA corto del commit
BACKEND_IMAGE=ghcr.io/angelnietos/erp/backend:main
FRONTEND_IMAGE=ghcr.io/angelnietos/erp/frontend:main
JOSANZ_WEB_APP_IMAGE=ghcr.io/angelnietos/erp/josanz-web-app:main
SAAS_PLATFORM_IMAGE=ghcr.io/angelnietos/erp/saas-platform:main
DOCUMENT_GENERATOR_IMAGE=ghcr.io/angelnietos/erp/document-generator:main
VERIFACTU_API_IMAGE=ghcr.io/angelnietos/erp/verifactu-api:main
VERIFACTU_WORKER_IMAGE=ghcr.io/angelnietos/erp/verifactu-worker:main

# Puertos HTTP publicados en el VPS (ajustar si hay reverse proxy / nginx)
FRONTEND_HTTP_PORT=8081
JOSANZ_WEB_APP_HTTP_PORT=8082
SAAS_PLATFORM_HTTP_PORT=8083
DOCUMENT_GENERATOR_HTTP_PORT=8084

# Staging: duplicar este archivo como deploy/.env.staging y usar tags :dev
# BACKEND_IMAGE=ghcr.io/angelnietos/erp/backend:dev
# JOSANZ_WEB_APP_IMAGE=ghcr.io/angelnietos/erp/josanz-web-app:dev
