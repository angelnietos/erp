# Copia estas variables en Railway → servicio keycloak → Variables
# Requiere un Postgres dedicado (plugin Railway Postgres o servicio keycloak-db).

# Admin console (cambia en producción)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Base de datos (Postgres interno de Railway)
KC_DB=postgres
# Opción A — URL JDBC completa (recomendado si Railway expone DATABASE_URL):
# KC_DB_URL=jdbc:postgresql://HOST:5432/keycloak
# Opción B — variables sueltas (referencia al servicio Postgres):
# KC_DB_URL_HOST=${{Postgres.PGHOST}}
# KC_DB_URL_PORT=${{Postgres.PGPORT}}
# KC_DB_URL_DATABASE=${{Postgres.PGDATABASE}}
# KC_DB_USERNAME=${{Postgres.PGUSER}}
# KC_DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Hostname público del servicio Keycloak en Railway (sin https://)
KC_HOSTNAME=keycloak-production.up.railway.app
KC_HOSTNAME_STRICT=false
KC_PROXY=edge
KC_HTTP_ENABLED=true

# Realms se importan al arrancar desde docker/keycloak/realms/
# Tras el primer deploy, actualiza redirectUris/post.logout en los JSON del realm
# con los dominios reales (ERP :4200 proxy, josanz-web-app, saas-platform).
