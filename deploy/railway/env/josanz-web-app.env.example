# Copia estas variables en Railway → servicio josanz-web-app → Variables
NODE_ENV=production
PORT=80

# Proxy Nginx /api → backend (misma red Railway)
# Sustituye por la URL privada del servicio backend si Railway la expone:
#   ${{ backend.RAILWAY_PRIVATE_DOMAIN }} con puerto 3000, o la URL pública del API.
BACKEND_PROXY_URL=http://backend.railway.internal:3000
