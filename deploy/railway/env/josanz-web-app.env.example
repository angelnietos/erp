# Copia estas variables en Railway → servicio josanz-web-app → Variables
NODE_ENV=production
PORT=80

# Proxy Nginx /api → backend (misma red Railway)
# Sustituye "backend" por el nombre exacto del servicio backend en Railway.
# Si el servicio se llama "backend":
#   http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:3000
# Si prefieres usar URL pública:
#   https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
# No uses http://backend:3000 salvo que Railway haya creado exactamente ese DNS.
BACKEND_PROXY_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:3000

# DNS interno de Docker/Railway para resolver dominios privados en proxy_pass dinámico.
NGINX_RESOLVER=127.0.0.11
