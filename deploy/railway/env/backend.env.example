# Copia estas variables en Railway → servicio backend → Variables
NODE_ENV=production
PORT=3000

# PostgreSQL (Railway Postgres plugin o URL externa)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# Auth / seguridad (genera valores fuertes en producción)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Orígenes permitidos: front + Storybook (dominios públicos Railway, separados por coma)
CORS_ORIGIN=https://josanz-web-app-production.up.railway.app,https://josanz-ui-storybook-production.up.railway.app

# Opcional: límites públicos
RATE_LIMIT_HEALTH_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=20
