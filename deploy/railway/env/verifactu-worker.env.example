# Verifactu Worker - Node.js worker service
NODE_ENV=production
PORT=3120

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# Redis (for job queue)
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Verifactu API URL
VERIFACTU_API_URL=https://verifactu-api-production.up.railway.app

# Sincroniza estado de cola con generic_crm (app Verifactu)
VERIFACTU_CRM_API_URL=https://verifactu-crm-api-production.up.railway.app/api
CRM_ERP_SYNC_API_KEY=change-me