# Staging (rama dev) — copiar a deploy/.env.staging en el servidor de staging.
# Mismas variables que deploy/.env.example; imágenes con tag :dev

COMPOSE_PROFILES=josanz,core

DATABASE_URL=postgresql://postgres:CAMBIAR@postgres:5432/josanz_erp_staging?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=josanz_erp_staging

JWT_SECRET=CAMBIAR_MINIMO_32_CARACTERES_STAGING
JWT_REFRESH_SECRET=OTRO_SECRETO_STAGING
CORS_ORIGIN=https://staging.tudominio.com,http://localhost:8082

BACKEND_IMAGE=ghcr.io/angelnietos/erp/backend:dev
JOSANZ_WEB_APP_IMAGE=ghcr.io/angelnietos/erp/josanz-web-app:dev
FRONTEND_IMAGE=ghcr.io/angelnietos/erp/frontend:dev
SAAS_PLATFORM_IMAGE=ghcr.io/angelnietos/erp/saas-platform:dev
DOCUMENT_GENERATOR_IMAGE=ghcr.io/angelnietos/erp/document-generator:dev
VERIFACTU_API_IMAGE=ghcr.io/angelnietos/erp/verifactu-api:dev
VERIFACTU_WORKER_IMAGE=ghcr.io/angelnietos/erp/verifactu-worker:dev

JOSANZ_WEB_APP_HTTP_PORT=8082
FRONTEND_HTTP_PORT=8081
SAAS_PLATFORM_HTTP_PORT=8083
DOCUMENT_GENERATOR_HTTP_PORT=8084
