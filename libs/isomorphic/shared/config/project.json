{
  "name": "shared-config",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs\\isomorphic\\shared\\config/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:config"
  ],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
