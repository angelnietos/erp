{
  "name": "crm-clients-backend",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/crm/node/backend/clients/backend",
  "sourceRoot": "libs/crm/node/backend/clients/backend/src",
  "projectType": "library",
  "implicitDependencies": ["crm-clients-core"],
  "tags": ["scope:clients", "type:backend"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/node/backend/clients/backend",
        "main": "libs/crm/node/backend/clients/backend/src/index.ts",
        "tsConfig": "libs/crm/node/backend/clients/backend/tsconfig.lib.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/crm/node/backend/clients/backend/jest.config.cjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
