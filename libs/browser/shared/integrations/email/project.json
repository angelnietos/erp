{
  "name": "shared-integrations-email",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs\\browser\\shared\\integrations\\email/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:integrations"
  ],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "outputPath": "dist/libs/shared/integrations/email",
        "main": "libs\\browser\\shared\\integrations\\email/src/index.ts",
        "tsConfig": "libs\\browser\\shared\\integrations\\email/tsconfig.lib.json",
        "assets": [
          {
            "glob": "*.md",
            "input": "libs/browser/shared/integrations/email",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs\\browser\\shared\\integrations\\email/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
