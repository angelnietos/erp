{
  "name": "shared-cqrs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs\\browser\\shared\\cqrs/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:cqrs"
  ],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/shared/cqrs",
        "main": "libs\\browser\\shared\\cqrs/src/index.ts",
        "tsConfig": "libs\\browser\\shared\\cqrs/tsconfig.lib.json",
        "assets": [
          {
            "glob": "*.md",
            "input": "libs/browser/shared/cqrs",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs\\browser\\shared\\cqrs/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
