{
  "name": "shared-auth-keycloak",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/browser/shared/auth-keycloak/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:auth"],
  "implicitDependencies": ["shared-data-access", "identity-api"],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "outputPath": "dist/libs/browser/shared/auth-keycloak",
        "main": "libs/browser/shared/auth-keycloak/src/index.ts",
        "tsConfig": "libs/browser/shared/auth-keycloak/tsconfig.lib.json",
        "external": ["@josanz-erp/shared-data-access", "@josanz-erp/identity-api"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/browser/shared/auth-keycloak/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}