flowchart TB
    subgraph SOURCES["Fuentes de feedback"]
        S1["Corrección Operaciones"]
        S2["Corrección Cliente"]
        S3["Falso positivo / negativo"]
    end

    S1 & S2 & S3 --> FE["Feedback Engine"]

    FE --> LB["Labeling asistido"]
    LB --> DS["Dataset versionado"]
    DS --> EV["Evaluation Pipeline"]
    EV --> GS["Golden set >= 200 casos"]

    GS --> FIT["Fitness Engine"]

    subgraph COMPONENTS["Componentes fitness"]
        F1["F1 Clasificacion 15%"]
        F2["F2 Extraccion 25%"]
        F3["F3 Validacion 25%"]
        F4["F4 FTR 15%"]
        F5["F5 Latencia 10%"]
        F6["F6 Coste 10%"]
    end

    FIT --> F1 & F2 & F3 & F4 & F5 & F6
    F1 & F2 & F3 & F4 & F5 & F6 --> FG["Fitness Global 0-100"]

    FG --> DEC{"Promovible?"}
    DEC -->|Si| MR["Model / Prompt Registry"]
    DEC -->|No| REF["Refinamiento"]

    MR --> P1["Extractores Document Intelligence"]
    MR --> P2["Reglas CAE YAML"]
    MR --> P3["Prompts Foundry"]

    REF --> EV

    MR --> RB["Rollback < 15 min"]
    FG --> DASH["Dashboard MLOps + informe trimestral"]

    style FE fill:#ffe0b2,stroke:#e65100
    style FIT fill:#ffcc80,stroke:#ef6c00,stroke-width:2px
    style FG fill:#ffb74d,stroke:#e65100,stroke-width:2px
    style COMPONENTS fill:#fff3e0,stroke:#ef6c00
